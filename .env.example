# Copy to .env and fill in. .env is never committed.

# Fuel Finder API login
FUEL_FINDER_CLIENT_ID=
FUEL_FINDER_CLIENT_SECRET=
FUEL_FINDER_BASE_URL=https://www.fuel-finder.service.gov.uk/api/v1
FUEL_FINDER_TOKEN_URL=https://www.fuel-finder.service.gov.uk/api/v1/oauth/generate_access_token

# Cloudflare R2 (fill in once the bucket and API token exist)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fuel-snapshots
